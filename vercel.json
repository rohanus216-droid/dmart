{
  "routes": [
    {
      "src": "/about",
      "dest": "/About.html"
    },
    {
      "src": "/adminpanel",
      "dest": "/adminpanel.html"
    },
    {
      "src": "/adminpanel.html",
      "dest": "/adminpanel.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html",
      "status": 404
    }
  ],
  "error": {
    "404": "/404.html"
  }
}
